<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ZarrNET</RootNamespace>
    <AssemblyName>ZarrNET</AssemblyName>
	<Description>A Zarr reader and writer in .NET</Description>
	<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
	<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	<PackageProjectUrl>https://biologytools.github.io/</PackageProjectUrl>
	<PackageTags>Biology; Microscopy; Whole-Slide-Image; Zarr; OME-Zarr; NGFF;</PackageTags>
	<PackageReleaseNotes>Adds Blosc bit-shuffle decoding for single-byte and multi-byte elements, improving compatibility with existing Zarr datasets. Includes regression coverage for LZ4-compressed byte and UInt16 data. Bit-shuffle encoding remains unsupported; decoding requires blocks containing a multiple of eight elements.</PackageReleaseNotes>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<Authors>Erik Repo</Authors>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<Version>0.8.2</Version>
	<AssemblyVersion>0.8.2.0</AssemblyVersion>
	<FileVersion>0.8.2.0</FileVersion>
	<PackageVersion>0.8.2</PackageVersion>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" Version="4.0.100.6" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.3" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
  <ItemGroup>
    <None Update="icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="ZarrNET.Tests\**\*.cs" />
  </ItemGroup>

</Project>
